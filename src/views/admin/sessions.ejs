<%- include('../layout/header', { pageTitle: 'Pointages', currentPage: 'sessions', user: user }) %>

<div class="card">
    <div class="card-header">
        <span class="card-title">Tous les pointages</span>
        <span class="badge badge-blue"><%= grouped.length %> salarié<%= grouped.length > 1 ? 's' : '' %></span>
    </div>

    <% if (grouped.length === 0) { %>
        <div class="empty-state" style="padding: var(--space-6)">Aucun pointage enregistré</div>
    <% } %>

    <% grouped.forEach(g => { %>
        <details class="sessions-group" id="employee-<%= g.employee.id %>">
            <summary class="sessions-group-header">
                <div class="employee-cell">
                    <div class="user-avatar avatar-dark avatar-sm">
                        <%= g.employee.name.charAt(0).toUpperCase() %>
                    </div>
                    <strong><%= g.employee.name %></strong>
                </div>
                <div class="sessions-group-meta">
                    <span class="badge badge-blue"><%= g.sessions.length %> pointage<%= g.sessions.length > 1 ? 's' : '' %></span>
                    <% if (g.sessions.some(s => s.endTime === null)) { %>
                        <span class="badge badge-green"><span class="badge-dot"></span>En cours</span>
                    <% } %>
                    <svg class="sessions-chevron" xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="6 9 12 15 18 9"/></svg>
                </div>
            </summary>
            <div class="table-wrap">
                <table>
                    <thead>
                        <tr>
                            <th>Entrée</th>
                            <th>Sortie</th>
                            <th>Statut</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% g.sessions.forEach(s => { %>
                            <tr>
                                <td><%= s.startTime %></td>
                                <td><%= s.endTime ?? '' %></td>
                                <td>
                                    <% if (s.endTime === null) { %>
                                        <span class="badge badge-green"><span class="badge-dot"></span>En cours</span>
                                    <% } else { %>
                                        <span class="badge badge-gray">Terminé</span>
                                    <% } %>
                                </td>
                            </tr>
                        <% }) %>
                    </tbody>
                </table>
            </div>
        </details>
    <% }) %>
</div>

<script>
  if (window.location.hash) {
    const target = document.querySelector('details' + window.location.hash);
    if (target) {
      target.open = true;
      target.scrollIntoView({ behavior: 'smooth', block: 'start' });
    }
  }
</script>

<%- include('../layout/footer') %>