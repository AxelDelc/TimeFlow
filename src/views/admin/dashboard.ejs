<%- include('../layout/header', { pageTitle: 'Tableau de bord', currentPage: 'dashboard', user: user, dashboardStats: stats }) %>

<div class="stats-bar">
    <div class="stats-bar-item">
        <span class="stats-bar-label">Total salariés</span>
        <span class="stats-bar-value"><%= stats.totalEmployees %></span>
    </div>
    <div class="stats-bar-item">
        <span class="stats-bar-label">Comptes actifs</span>
        <span class="stats-bar-value"><%= stats.activeEmployees %></span>
    </div>
    <div class="stats-bar-item">
        <span class="stats-bar-label">Pointages aujourd'hui</span>
        <span class="stats-bar-value"><%= stats.sessionsToday %></span>
    </div>
    <div class="stats-bar-item stats-bar-item--active">
        <span class="stats-bar-label"><span class="presence-dot"></span>Présents</span>
        <span class="stats-bar-value"><%= stats.currentlyIn %></span>
    </div>
</div>

<div class="dashboard-grid">

    <div class="card">
        <div class="card-header">
            <span class="card-title">Activité récente</span>
            <a href="/admin/sessions" class="btn btn-ghost btn-sm">Voir tout</a>
        </div>
        <div class="table-wrap">
            <table>
                <thead>
                    <tr>
                        <th>Salarié</th>
                        <th class="col-time">Entrée</th>
                        <th class="col-time">Sortie</th>
                        <th>Statut</th>
                    </tr>
                </thead>
                <tbody>
                    <% if (recentSessions.length === 0) { %>
                        <tr><td colspan="4" class="empty-state">Aucun pointage</td></tr>
                    <% } %>
                    <% recentSessions.forEach(s => { %>
                        <tr>
                            <td>
                                <div class="employee-cell">
                                    <span class="user-avatar avatar-sm avatar-dark"><%= s.user.name.charAt(0).toUpperCase() %></span>
                                    <strong><%= s.user.name %></strong>
                                </div>
                            </td>
                            <td class="col-time"><%= s.startTime %></td>
                            <td class="col-time"><%= s.endTime || '—' %></td>
                            <td>
                                <% if (!s.endTime) { %>
                                    <span class="badge badge-green"><span class="badge-dot"></span>En cours</span>
                                <% } else { %>
                                    <span class="badge badge-gray">Terminé</span>
                                <% } %>
                            </td>
                        </tr>
                    <% }) %>
                </tbody>
            </table>
        </div>
    </div>

    <div class="card">
        <div class="card-header">
            <span class="card-title">Présents</span>
            <span class="badge badge-green"><span class="badge-dot"></span><%= activeNow.length %></span>
        </div>
        <div class="card-body">
            <% if (activeNow.length === 0) { %>
                <div class="empty-state" style="padding: var(--space-3) 0; text-align:left">Personne en ce moment</div>
            <% } else { %>
                <div class="active-list">
                    <% activeNow.forEach(a => { %>
                        <div class="active-item">
                            <div class="active-avatar"><%= a.user.name.charAt(0).toUpperCase() %></div>
                            <div>
                                <div class="active-name"><%= a.user.name %></div>
                                <div class="active-since">depuis <%= a.startTime %></div>
                            </div>
                        </div>
                    <% }) %>
                </div>
            <% } %>
        </div>
    </div>

</div>

<%- include('../layout/footer') %>
