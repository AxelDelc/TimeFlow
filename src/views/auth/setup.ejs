<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Installation · TimeFlow</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/css/base.css">
    <link rel="stylesheet" href="/css/components.css">
    <link rel="stylesheet" href="/css/login.css">
</head>
<body>
<div class="login-page">
    <div class="login-card">
        <div class="login-logo">
            <div class="login-logo-mark">TF</div>
            <span class="login-logo-text">TimeFlow</span>
        </div>

        <h2>Première installation</h2>
        <p style="color: var(--text-muted); margin-bottom: 1.5rem; font-size: 0.9rem;">
            Créez le compte administrateur pour commencer à utiliser TimeFlow.
        </p>

        <% if (typeof error !== 'undefined' && error) { %>
            <div class="alert alert-error"><%= error %></div>
        <% } %>

        <form method="POST" action="/setup">
            <div class="form-group">
                <label for="name">Nom complet</label>
                <input id="name" name="name" type="text" placeholder="Jean Dupont" required autofocus />
            </div>
            <div class="form-group">
                <label for="email">Adresse email</label>
                <input id="email" name="email" type="email" placeholder="admin@mon-entreprise.fr" required />
            </div>
            <div class="form-group">
                <label for="password">Mot de passe <span style="color: var(--text-muted); font-size:0.8rem;">(8 caractères minimum)</span></label>
                <input id="password" name="password" type="password" placeholder="••••••••" required />
            </div>
            <div class="form-footer">
                <button type="submit" class="btn btn-primary btn-full">Créer le compte administrateur</button>
            </div>
        </form>
    </div>
</div>
</body>
</html>