<%- include('../layout/header', { pageTitle: 'Mon espace', currentPage: 'dashboard', user: user, employeeDate: employeeDate }) %>

<% const activeSession = sessions.find(s => !s.endTime); %>

<div class="punch-wrapper">
    <div class="punch-card">
        <div class="punch-status<%= activeSession ? ' punch-status--active' : '' %>">
            <span class="punch-status-dot"></span>
            <% if (activeSession) { %>
                En cours &middot; pointé à <%= activeSession.startTimeFormatted %>
            <% } else { %>
                Aucune session active
            <% } %>
        </div>
        <div class="punch-actions">
            <% if (!activeSession) { %>
                <form method="POST" action="/employee/start" class="punch-primary-form">
                    <button class="punch-btn--primary punch-in">Pointer entrée</button>
                </form>
                <form method="POST" action="/employee/end" class="punch-secondary-form">
                    <button class="punch-btn--secondary" disabled>Pointer sortie</button>
                </form>
            <% } else { %>
                <form method="POST" action="/employee/end" class="punch-primary-form">
                    <button class="punch-btn--primary punch-out">Pointer sortie</button>
                </form>
                <form method="POST" action="/employee/start" class="punch-secondary-form">
                    <button class="punch-btn--secondary" disabled>Pointer entrée</button>
                </form>
            <% } %>
        </div>
    </div>
</div>

<div class="card sessions-card">
    <div class="card-header">
        <span class="card-title">Mes pointages</span>
    </div>
    <div class="table-wrap">
        <table>
            <thead>
                <tr>
                    <th class="col-time">Entrée</th>
                    <th class="col-time">Sortie</th>
                    <th>Statut</th>
                </tr>
            </thead>
            <tbody>
                <% if (sessions.length === 0) { %>
                    <tr><td colspan="3" class="empty-state">Aucun pointage enregistré</td></tr>
                <% } %>
                <% sessions.forEach(s => { %>
                    <tr<%= !s.endTime ? ' class="sessions-row-active"' : '' %>>
                        <td class="col-time"><%= s.startTimeFormatted %></td>
                        <td class="col-time"><%= s.endTimeFormatted || '—' %></td>
                        <td>
                            <% if (!s.endTime) { %>
                                <span class="badge badge-green"><span class="badge-dot"></span>En cours</span>
                            <% } else { %>
                                <span class="badge badge-gray">Terminé</span>
                            <% } %>
                        </td>
                    </tr>
                <% }) %>
            </tbody>
        </table>
    </div>
</div>

<%- include('../layout/footer') %>
